# API (mira-api). Local: http://localhost:3000 — Prod: https://mira-api-xveu.onrender.com
# En emulador Android usa http://10.0.2.2:3000; en dispositivo físico la IP de tu máquina.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Geoapify (parkings) — https://geoapify.com (3000 req/día gratis)
EXPO_PUBLIC_GEOAPIFY_KEY=

# URL de la WEB (emails de Firebase: verificación y reset de contraseña abren el navegador)
EXPO_PUBLIC_WEB_URL=https://restaurante-mira-frontend.vercel.app

# Google Sign-In (expo-auth-session → id_token → Firebase)
# Google Cloud Console → credenciales OAuth (tipo "Web application") del proyecto
# restaurante-mira-18e0c. Añade als URIs de redirección:
#   exp://<host>/--/auth  (Expo Go),  mira://auth (build)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=mira://auth
